# LLM provider: "anthropic", "openai", or "nim"
LLM_PROVIDER=nim

# Semantic Scholar API key (optional but recommended — avoids rate limiting)
# Get one free at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# Optional: override the default model for the chosen provider
# Defaults: anthropic=claude-sonnet-4-20250514, openai=gpt-4o, nim=deepseek-ai/deepseek-v4-pro
# LLM_MODEL=

# API keys — only the key for your chosen provider is required
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
NIM_API_KEY=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

# Optional: override the NIM endpoint (default: https://integrate.api.nvidia.com/v1)
# NIM_BASE_URL=http://0.0.0.0:8000/v1
